{
	"name": "031_NextedJson",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['CustomerID']"
								},
								"sink": {
									"name": "CustomerID",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['FirstName']"
								},
								"sink": {
									"name": "FirstName",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['LastName']"
								},
								"sink": {
									"name": "LastName",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['Country']"
								},
								"sink": {
									"name": "Country",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['Location']['States']"
								},
								"sink": {
									"name": "State",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['Location']['pincode']"
								},
								"sink": {
									"name": "pincode",
									"type": "Int32"
								}
							},
							{
								"source": {
									"path": "$['Age']"
								},
								"sink": {
									"name": "Age",
									"type": "String"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "ds_nextedjson_customer",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "sinksqlnextedjson",
						"type": "DatasetReference"
					}
				]
			}
		],
		"folder": {
			"name": "All Pipelines"
		},
		"annotations": [],
		"lastPublishTime": "2025-09-07T09:30:42Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
